#!/usr/bin/env bash
# Pre-push gate — everything pre-commit runs (build first, so cross-workspace
# imports resolve through each package's dist/), plus the contract drift check
# and Playwright e2e.
# Escape hatch (documented, use sparingly): git push --no-verify
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

# Generated artifacts of packages/contract. SPEC.md §9.3: regenerating from the
# route definitions must produce no diff, or the push fails naming the fix.
CONTRACT_ARTIFACTS=(
  packages/contract/openapi.json
  packages/contract/src/client/schema.generated.ts
)

fail=0
step() {
  local name="$1"; shift
  echo "pre-push ▶ $name"
  if ! "$@"; then
    echo "pre-push ✗ $name failed."
    fail=1
  fi
}

contract_drift() {
  local stale="  The committed API contract is stale relative to packages/contract/src.
  Fix: npm run generate -w packages/contract && git add ${CONTRACT_ARTIFACTS[*]}"

  # Regenerating must be a no-op. Hashing before and after catches staleness even
  # for an artifact git does not track yet, which `git diff` would silently skip.
  local before after
  before="$(cat "${CONTRACT_ARTIFACTS[@]}" 2>/dev/null | shasum)"
  npm run --silent generate -w packages/contract > /dev/null || return 1
  after="$(cat "${CONTRACT_ARTIFACTS[@]}" | shasum)"
  if [ "$before" != "$after" ]; then
    echo "$stale"
    return 1
  fi

  # Second guard, for artifacts already tracked: what is about to be pushed must
  # match what regeneration produces, so a stale commit cannot slip through.
  if ! git diff --quiet --exit-code HEAD -- "${CONTRACT_ARTIFACTS[@]}"; then
    echo "$stale"
    git --no-pager diff --stat HEAD -- "${CONTRACT_ARTIFACTS[@]}"
    return 1
  fi
}

step "build"           npm run --silent build
step "contract drift"  contract_drift
step "eslint"          npm run --silent lint
step "prettier check"  npm run --silent format:check
step "typecheck"       npm run --silent typecheck
step "unit tests"      npm test --silent

if compgen -G "apps/ui/e2e/*.spec.ts" > /dev/null; then
  step "playwright e2e" npm run --silent e2e
else
  echo "pre-push ▷ playwright e2e skipped (no specs in apps/ui/e2e/ yet)"
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-push: blocked."
  exit 1
fi
echo "pre-push ✓ all checks passed"
