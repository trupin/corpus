#!/usr/bin/env bash
# Pre-push gate — everything pre-commit runs (build first, so cross-workspace
# imports resolve through each package's dist/), plus version singularity, the
# generated-artifact drift check and Playwright e2e.
# Escape hatch (documented, use sparingly): git push --no-verify
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

# Drain the ref list git writes to our stdin, before anything else runs.
# Nothing below reads it, but a hook that leaves its stdin unread is a hook that
# can strand a writer. Consuming it costs one process. (This was first shipped
# as a fix for the exit-141 push failures below — it is not; see INFRA-019.)
refs_to_push="$(cat)"
readonly refs_to_push

# ── Why a push can die with 141 *after* this gate passes (INFRA-019) ──────────
#
# `GIT_TRACE=1` on a failing push shows the order that matters:
#
#   run_command: ssh git@github.com 'git-receive-pack ...'   <- 11:29:23
#   run_command: .githooks/pre-push origin git@github.com:…   <- 11:29:25
#   (this gate runs for three to five minutes)
#   pre-push ✓ all checks passed
#   <nothing — git is gone, exit 141>
#
# git opens the transport to the remote **before** it runs us, then waits. By the
# time this gate finishes, the server has closed an idle `git-receive-pack`
# session, and git's first write to that dead connection raises SIGPIPE. Nothing
# is on the remote, the gate output says everything passed, and git prints no
# error at all because it never reaches its reporting path.
#
# It reads as intermittent because it is a race against the remote's idle
# timeout: a fast gate wins, a gate that ran the e2e suite loses. It is not about
# tags versus branches, and not about ref creation versus update.
#
# The fix is SSH keepalives — and it CANNOT be set here. git opened the
# connection before it ran us, so exporting `GIT_SSH_COMMAND` from this script
# reaches only this script's own children, never the transport already waiting.
# It has to be in git's config before the push starts, which is why
# `npm run setup-hooks` now sets `core.sshCommand` alongside `core.hooksPath`.
# A clone that skipped that step gets the old symptom, so if a push exits 141
# with a clean gate above it, check `git config core.sshCommand` first.

# The e2e suite binds a port for its Vite `webServer`. `vite.config.ts` pins the
# dev server to 5173 (SPEC.md §3) and that is right for `npm run dev`; it is the
# wrong default for a hook, which must not fight a dev server the developer
# already has running there — and on the maintainer's machine 5173 is held by an
# unrelated ssh tunnel, so an unqualified `git push` fails at this step. An
# explicit value always wins: `CORPUS_UI_PORT=5999 git push`.
export CORPUS_UI_PORT="${CORPUS_UI_PORT:-5273}"

# The e2e suite's hermetic premise is a *dead* API origin: `vite.config.ts`
# proxies to 8765 by default, which is exactly where a personally-installed
# `corpus` server listens on a maintainer's machine — and with a live server
# there, the two "server unreachable" specs fail (the health notice never
# renders) while the rest of the suite quietly talks to a real workspace. Pin
# the proxy at a port nothing binds so the suite tests the app, not whatever
# 8765 happens to hold. An explicit value always wins.
export CORPUS_SERVER_ORIGIN="${CORPUS_SERVER_ORIGIN:-http://127.0.0.1:8790}"

fail=0
step() {
  local name="$1"; shift
  echo "pre-push ▶ $name"
  if ! "$@"; then
    echo "pre-push ✗ $name failed."
    fail=1
  fi
}

# First because it is the cheapest and needs no build: one version number
# describes the whole tool (INFRA-008), and drift is far easier to fix here than
# after a `v*` tag has been pushed, where the same check is the publish guard.
# It reads the committed tree as well as the working tree (INFRA-022), so this
# step sees what is about to be pushed rather than what is merely on disk.
# The tarball audit (`pack:check`) deliberately stays CI-only — it bundles and
# packs, which is too slow for a push.
step "version singularity"         npm run --silent version:check
step "build"                       npm run --silent build
# One inventory, two consumers: this and the `generated artifacts drift` step in
# CI both run scripts/check-generated-artifacts.ts (openapi.json,
# schema.generated.ts, docs/cli.md). Never re-list the artifacts here.
step "generated artifacts drift"   node --import tsx scripts/check-generated-artifacts.ts
step "eslint"                      npm run --silent lint
step "prettier check"              npm run --silent format:check
step "typecheck"                   npm run --silent typecheck
step "unit tests"                  npm test --silent

if compgen -G "apps/ui/e2e/*.spec.ts" > /dev/null; then
  step "playwright e2e" npm run --silent e2e
else
  echo "pre-push ▷ playwright e2e skipped (no specs in apps/ui/e2e/ yet)"
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-push: blocked."
  exit 1
fi
echo "pre-push ✓ all checks passed"
