#!/usr/bin/env bash
# Pre-commit gate — deliberately tiny (INFRA-025, user decision 2026-08-07:
# "we should be aiming for 10-15 second max").
#
# What this hook is for: catching what is cheap to catch and annoying to fix
# later. That is formatting, and a dependency advisory.
#
# What it is NOT for any more: build, type-aware eslint, `tsc --noEmit`, and the
# unit suite. Each is compile-class work — even linting a single file makes
# @typescript-eslint build the whole program, and the full sweep measured ~2.5
# minutes at 3 GB resident. None of it fits in fifteen seconds, and none of it
# needs to be here:
#
#   `CI / validate` runs build, lint, format, typecheck, the full unit suite and
#   Playwright on every pushed head, and a PR cannot merge until it is green.
#
# So the cost of moving them is a red PR and a second push — never a bad merge.
# Run them by hand when a change warrants it: `npm run lint`, `npm run
# typecheck`, `npm test`, `npm run e2e`.
#
# Escape hatch (documented, use sparingly): git commit --no-verify
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

fail=0
step() {
  local name="$1"; shift
  echo "pre-commit ▶ $name"
  if ! "$@"; then
    echo "pre-commit ✗ $name failed — fix the errors above ('npm run format' fixes formatting)."
    fail=1
  fi
}

# Scoped to the diff, and to one list, so nothing can disagree about what
# changed. `--diff-filter=ACM` drops deletions, which have no file to check.
staged="$(git diff --cached --name-only --diff-filter=ACM)"

# The supply-chain gate (INFRA-013): one registry round-trip, no build output
# needed, and an advisory is not something the next five minutes of compiling
# could change. `--tolerate-unreachable-registry` is passed HERE and nowhere
# else — a dead network warns and lets the commit through, while CI runs the
# identical command without the flag and fails closed.
step "npm audit"  node --import tsx scripts/check-audit.ts --tolerate-unreachable-registry

# Prettier is the whole remaining gate, and it is scoped: it formats markdown as
# well as code, so a prose-only commit still pays it — in milliseconds.
# `--ignore-unknown` so a staged file prettier has no parser for is skipped
# rather than failing the commit.
if [ -n "$staged" ]; then
  # shellcheck disable=SC2086
  step "prettier (staged)" npx prettier --check --ignore-unknown $(printf '%s\n' "$staged" | tr '\n' ' ')
else
  echo "pre-commit ▷ nothing staged"
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: blocked. Nothing was committed."
  exit 1
fi
echo "pre-commit ✓ (build, lint, typecheck and tests run in CI — INFRA-025)"
