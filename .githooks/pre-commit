#!/usr/bin/env bash
# Pre-commit gate — full validation by explicit project decision (see CLAUDE.md):
# build + lint + format + typecheck + unit tests. Playwright e2e runs pre-push only.
# Build runs first: cross-workspace imports (@corpus/contract, @corpus/kit)
# resolve through each package's exports map into dist/, so lint, typecheck and
# tests all need fresh build output to see the real types.
# Escape hatch (documented, use sparingly): git commit --no-verify
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

fail=0
step() {
  local name="$1"; shift
  echo "pre-commit ▶ $name"
  if ! "$@"; then
    echo "pre-commit ✗ $name failed — fix the errors above (or 'npm run lint:fix' / 'npm run format' for auto-fixables)."
    fail=1
  fi
}

# First, ahead of the expensive build: the supply-chain gate (INFRA-013) needs no
# build output, costs one registry round-trip (~0.7s), and a dependency advisory
# is not something the next five minutes of compiling and testing can change. It
# still goes through step() like everything else, so a developer sees every
# failing check in one run rather than stopping at the first.
# `--tolerate-unreachable-registry` is passed HERE and nowhere else: a dead
# network warns loudly and lets the commit through, while CI runs the identical
# command without the flag and fails closed. The flag governs only the
# registry-unreachable branch — advisories block a commit with or without it.
step "npm audit"       node --import tsx scripts/check-audit.ts --tolerate-unreachable-registry
step "build"           npm run --silent build
step "eslint"          npm run --silent lint
step "prettier check"  npm run --silent format:check
step "typecheck"       npm run --silent typecheck
step "unit tests"      npm test --silent

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: blocked. Nothing was committed."
  exit 1
fi
echo "pre-commit ✓ all checks passed"
