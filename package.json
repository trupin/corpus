{
  "name": "corpus-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "setup-hooks": "git config core.hooksPath .githooks",
    "build": "npm run build -w packages/contract && npm run build -w packages/kit && npm run build -w apps/cli && npm run build -w apps/server -w apps/ui --if-present",
    "clean": "rm -rf packages/*/dist apps/*/dist plugins/*/dist coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --config apps/ui/playwright.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.30.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.0"
  }
}
