{
  "name": "@corpus/kit",
  "private": true,
  "version": "0.23.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./row.css": "./src/row/row.css",
    "./markdown.css": "./src/markdown/markdown.css",
    "./autocomplete.css": "./src/components/Autocomplete/autocomplete.css",
    "./composer.css": "./src/components/Composer/composer.css",
    "./address.css": "./src/address/address.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/tokens.css",
    "src/row/row.css",
    "src/markdown/markdown.css",
    "src/components/Autocomplete/autocomplete.css",
    "src/components/Composer/composer.css",
    "src/address/address.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@corpus/contract": "*",
    "@tanstack/react-query": "^5.101.4",
    "react-markdown": "^9.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
