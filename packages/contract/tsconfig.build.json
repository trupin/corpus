{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"],
  // `src/generation` is repo tooling behind `npm run generate`, not part of the
  // published surface — keeping it out of dist/ keeps `openapi-typescript` a
  // devDependency that consumers never resolve.
  "exclude": ["src/**/*.test.ts", "src/generation/**"]
}
