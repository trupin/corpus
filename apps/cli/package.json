{
  "name": "@corpus/cli",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "corpus": "./dist/bin/corpus.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin/corpus.js",
    "dev": "tsx src/bin/corpus.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@corpus/contract": "*"
  }
}
