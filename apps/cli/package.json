{
  "name": "@corpus/cli",
  "private": true,
  "version": "0.28.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "corpus": "./dist/bin/corpus.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bench:startup": "tsx scripts/bench-startup.ts",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin/corpus.js",
    "corpus": "node dist/bin/corpus.js",
    "dev": "tsx src/bin/corpus.ts",
    "docs:cli": "tsx scripts/generate-docs.ts",
    "test": "vitest run --root ../.. apps/cli",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@corpus/contract": "*",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
