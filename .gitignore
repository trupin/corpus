# Dependencies & build output
node_modules/
dist/
# The published package, assembled by `npm run package:build` (INFRA-008).
# `dist/` above does not match it, and it is a build artifact like any other.
dist-package/
build/
coverage/
coverage-raw/
*.tsbuildinfo

# Playwright. The rooted pair matters: a run invoked from the repo root (rather
# than from apps/ui) writes its output here, and only the apps/ui paths were
# covered — a stray `test-results/` then shows up as untracked repo content.
apps/ui/test-results/
apps/ui/playwright-report/
/test-results/
/playwright-report/

# Local env
.env
.env.local

# macOS
.DS_Store

# Editors
.idea/
.vscode/
*.swp

# Agent worktrees (created by the dev harness, never repo content)
.claude/worktrees/

# Raw rehearsal run records (INFRA-033): evidence for investigating a finding,
# never repo content. The scorecard beside them IS committed.
rehearsals/out/

# npm pack artifacts at the repo root (PR #11 review finding 32)
/*.tgz
