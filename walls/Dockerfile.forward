# corpus — dashboard port-forwarder.
#
# The agent box sits on an `internal: true` network (no direct internet —
# that's its egress wall), and Docker will NOT publish a host port for a
# container that's only on an internal network. So the agent can't expose its
# own port. This tiny socat sidecar sits on BOTH the internal network (to
# reach the agent) and the egress network (which has host connectivity, so a
# published port works), and forwards the one dashboard port through to the
# agent. It runs nothing but a TCP forward — no app logic, minimal surface.

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      socat \
    && rm -rf /var/lib/apt/lists/*

# The forward target is set by compose `command:` so the port lives in one
# place (compose.yml) next to the publish mapping.
ENTRYPOINT ["socat"]
