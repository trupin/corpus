# corpus — host-only sandbox toggles. Copy to walls/.env and edit; up.sh
# sources walls/.env so compose's ${VAR} substitution picks these up.
# walls/.env is gitignored (host-only). These are the knobs compose references
# via ${...} — set them HERE (not in secrets/, which is for the credential
# carry-in: the Claude OAuth + deploy-key volumes; see secrets/README.md).
#
#   cp walls/.env.example walls/.env

# Subscription auth: the long-lived token from
#   docker compose -f walls/compose.yml exec -u node agent claude setup-token
# Paste it HERE (this file is gitignored), NOT into a terminal/chat transcript.
# The in-box agent authenticates with it. (Or leave blank and use the in-box
# login to persist a credential into the claude_home volume.)
CLAUDE_CODE_OAUTH_TOKEN=

# Auto-start the dev stack (bun run watch) on boot. 1 = default. While the
# greenfield repo has no `watch` script, boot idles either way; 0 = always
# idle: you `exec -u node agent bash` and run things by hand.
CORPUS_RUN_WATCH=1

# Start the agent loop on boot (the reference agent-runner watching the event
# queue). 0 = dev stack only. Leave 0 until the framework exists.
CORPUS_RUN_LOOP=0

# File-watching over virtiofs needs polling for invalidation — ON by default
# in compose. Set 0 only if you have a setup where native watching works.
CHOKIDAR_USEPOLLING=1

# Shared-secret token for the event-queue HTTP surface. Blank = no token check
# (loopback + the box boundary are the gates).
CORPUS_EVENT_TOKEN=

# Resource caps for the agent box (a runaway can't starve the host).
CORPUS_AGENT_MEM=4g
CORPUS_AGENT_CPUS=3

# Colima VM caps (read by up.sh). NOTE: the VM is shared with any other
# sandbox (e.g. pa-sandbox) — whoever starts Colima first sets these.
COLIMA_CPUS=4
COLIMA_MEM=8
COLIMA_DISK=60

# Git identity for headless commits from inside the box.
GIT_AUTHOR_NAME=corpus agent
GIT_AUTHOR_EMAIL=agent@localhost
